<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0B0B0A" />
  <title>HELM — Command Deck</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
:root {
  --bg: #0B0B0A;
  --bg-2: #10100e;
  --surface: #141412;
  --surface-2: #1b1b18;
  --paper: #F3F0E8;
  --paper-dim: #d8d4c8;
  --accent: #C4C8BF;
  --accent-2: #9aa197;
  --muted: #8c8c88;
  --line: #2a2a26;
  --line-2: #3a3a34;
  --ink: #1a1a16;
  --danger: #c45c4a;
  --ok: #8aa37a;
  --shadow: 0 24px 60px rgba(0,0,0,.45);
  --serif: "Fraunces", "Iowan Old Style", "Palatino Linotype", Palatino, serif;
  --sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  --radius: 14px;
  --safe-b: env(safe-area-inset-bottom, 12px);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
html { background: var(--bg); color: var(--paper); }
body {
  font-family: var(--sans);
  background:
    radial-gradient(1200px 600px at 80% -10%, rgba(196,200,191,.06), transparent 50%),
    radial-gradient(800px 400px at -10% 110%, rgba(243,240,232,.04), transparent 45%),
    var(--bg);
  min-height: 100dvh;
  letter-spacing: .01em;
  -webkit-font-smoothing: antialiased;
}

button, input, textarea, select { font: inherit; color: inherit; }
button { cursor: pointer; }
img { max-width: 100%; }

.app {
  max-width: 1120px;
  margin: 0 auto;
  padding: 16px 16px 108px;
}

/* Header */
.top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 0 18px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 18px;
}
.brand { display: flex; gap: 12px; align-items: center; min-width: 0; }
.mark {
  width: 42px; height: 42px; flex: 0 0 42px;
  border: 1px solid var(--line-2);
  border-radius: 50%;
  display: grid; place-items: center;
  background: var(--surface);
}
.mark svg { width: 26px; height: 26px; }
.brand h1 {
  font-family: var(--serif);
  font-weight: 460;
  font-size: 22px;
  margin: 0;
  letter-spacing: .04em;
  line-height: 1.1;
}
.brand .sub {
  color: var(--muted);
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  margin-top: 3px;
}
.meta {
  text-align: right;
  color: var(--muted);
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  line-height: 1.6;
}
.meta strong { color: var(--paper-dim); font-weight: 500; display: block; letter-spacing: .08em; }

/* Views */
.view { display: none; animation: rise .28s ease; }
.view.on { display: block; }
@keyframes rise {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}

.kicker {
  font-size: 11px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--accent-2);
  margin: 0 0 8px;
}
.lead {
  font-family: var(--serif);
  font-size: 28px;
  font-weight: 420;
  line-height: 1.2;
  margin: 0 0 8px;
}
.blurb { color: var(--muted); font-size: 14px; line-height: 1.55; margin: 0 0 20px; max-width: 52ch; }

/* Agent grid */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.agent {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px 12px 12px;
  text-align: left;
  min-height: 132px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  transition: border-color .15s, transform .15s, background .15s;
}
.agent:hover, .agent:focus-visible {
  border-color: var(--accent-2);
  transform: translateY(-1px);
  outline: none;
}
.agent .rank {
  font-size: 10px;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--accent-2);
}
.agent .name {
  font-family: var(--serif);
  font-size: 18px;
  line-height: 1.1;
}
.agent .role { color: var(--muted); font-size: 12px; line-height: 1.4; flex: 1; }
.agent .dotrow { display: flex; align-items: center; gap: 6px; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px rgba(138,163,122,.6); }

/* Chat */
.chat-head {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 12px;
}
.back {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--paper-dim);
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 12px;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.chat-head .who { min-width: 0; }
.chat-head .who .name { font-family: var(--serif); font-size: 22px; margin: 0; }
.chat-head .who .role { color: var(--muted); font-size: 12px; }
.thread {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  min-height: 42vh;
  max-height: 52vh;
  overflow: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.bubble {
  max-width: 92%;
  padding: 10px 12px;
  border-radius: 12px;
  font-size: 14px;
  line-height: 1.55;
  white-space: pre-wrap;
}
.bubble.me {
  align-self: flex-end;
  background: var(--paper);
  color: var(--ink);
  border-bottom-right-radius: 4px;
}
.bubble.them {
  align-self: flex-start;
  background: var(--surface-2);
  border: 1px solid var(--line);
  border-bottom-left-radius: 4px;
}
.bubble .tag {
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--accent-2);
  margin-bottom: 6px;
}
.composer {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}
.composer textarea {
  flex: 1;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px;
  min-height: 52px;
  max-height: 140px;
  resize: vertical;
}
.composer textarea:focus, input:focus, select:focus {
  outline: 1px solid var(--accent-2);
  border-color: var(--accent-2);
}
.send, .btn {
  background: var(--paper);
  color: var(--ink);
  border: 0;
  border-radius: 12px;
  padding: 0 16px;
  font-weight: 560;
  letter-spacing: .04em;
}
.btn.ghost {
  background: transparent;
  color: var(--paper-dim);
  border: 1px solid var(--line);
}
.btn.full { width: 100%; padding: 12px; margin-top: 8px; }
.row-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }

/* Council */
.council-box textarea {
  width: 100%;
  min-height: 110px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px;
  resize: vertical;
}
.minutes { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; }
.minute {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px;
}
.minute.helm {
  background: linear-gradient(180deg, #1a1a16, var(--surface));
  border-color: var(--line-2);
}
.minute h3 {
  margin: 0 0 6px;
  font-size: 13px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--accent);
  font-weight: 500;
}
.minute p { margin: 0; font-size: 14px; line-height: 1.55; color: var(--paper-dim); white-space: pre-wrap; }

/* Forms / dossier / log */
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 14px;
  margin-bottom: 10px;
}
.card h3 {
  margin: 0 0 10px;
  font-family: var(--serif);
  font-weight: 460;
  font-size: 18px;
}
label {
  display: block;
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 10px 0 6px;
}
input[type="text"], select, textarea.field {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 10px 12px;
}
.entry {
  border-bottom: 1px solid var(--line);
  padding: 10px 0;
}
.entry:last-child { border-bottom: 0; }
.entry .when { font-size: 11px; color: var(--muted); letter-spacing: .08em; text-transform: uppercase; }
.entry .body { margin-top: 4px; font-size: 14px; line-height: 1.5; white-space: pre-wrap; }
.chips { display: flex; gap: 6px; flex-wrap: wrap; margin: 8px 0 14px; }
.chip {
  border: 1px solid var(--line);
  background: var(--surface);
  border-radius: 999px;
  padding: 6px 10px;
  font-size: 12px;
  color: var(--paper-dim);
}
.chip.on { border-color: var(--accent); color: var(--paper); }
.task {
  display: flex; gap: 10px; align-items: flex-start;
  padding: 8px 0;
  border-bottom: 1px solid var(--line);
}
.task input { margin-top: 3px; accent-color: var(--accent); }
.task.done .t { text-decoration: line-through; color: var(--muted); }
.task .own { font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--accent-2); }

/* Dock */
.dock {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: rgba(11,11,10,.92);
  backdrop-filter: blur(16px);
  border-top: 1px solid var(--line);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  padding: 8px 6px calc(8px + var(--safe-b));
  z-index: 20;
}
.dock button {
  background: transparent;
  border: 0;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .1em;
  text-transform: uppercase;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 6px 0;
}
.dock button.on { color: var(--paper); }
.dock svg { width: 18px; height: 18px; }

.hint { color: var(--muted); font-size: 12px; line-height: 1.5; }

@media (max-width: 640px) {
  .lead { font-size: 24px; }
  .grid { grid-template-columns: 1fr 1fr; }
  .agent { min-height: 118px; }
  .brand h1 { font-size: 18px; }
}
@media (min-width: 900px) {
  .app { padding-bottom: 40px; padding-top: 28px; }
  .dock { display: none; }
  .desk-nav { display: flex !important; }
}
.desk-nav { display: none; gap: 6px; flex-wrap: wrap; margin: -4px 0 18px; }
.desk-nav button {
  background: transparent;
  border: 1px solid var(--line);
  color: var(--muted);
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 11px;
  letter-spacing: .14em;
  text-transform: uppercase;
}
.desk-nav button.on { color: var(--paper); border-color: var(--accent-2); }

</style>
</head>
<body>
  <div class="app">
    <header class="top">
      <div class="brand">
        <div class="mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" fill="none">
            <circle cx="32" cy="32" r="22" stroke="#C4C8BF" stroke-width="1.4"/>
            <circle cx="32" cy="32" r="7" stroke="#F3F0E8" stroke-width="1.4"/>
            <path d="M32 8v12M32 44v12M8 32h12M44 32h12M14.5 14.5l8.5 8.5M41 41l8.5 8.5M14.5 49.5l8.5-8.5M41 23l8.5-8.5" stroke="#C4C8BF" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h1 id="companyTitle">HELM</h1>
          <div class="sub">Private command · nine officers</div>
        </div>
      </div>
      <div class="meta">
        <strong id="clockDate">—</strong>
        <span id="clockTime">—</span>
      </div>
    </header>

    <nav class="desk-nav" id="deskNav"></nav>

    <section class="view on" id="view-bridge">
      <p class="kicker">The bridge</p>
      <h2 class="lead">Nine officers. One deck.</h2>
      <p class="blurb">Open an officer for a private counsel. Convene the full council when the decision needs every chair. Everything you write stays on this device.</p>
      <div class="grid" id="agentGrid"></div>
    </section>

    <section class="view" id="view-chat">
      <div class="chat-head">
        <button class="back" type="button" data-go="bridge">Back</button>
        <div class="who">
          <p class="name" id="chatName">—</p>
          <div class="role" id="chatRole">—</div>
        </div>
      </div>
      <div class="thread" id="thread"></div>
      <form class="composer" id="chatForm">
        <textarea id="chatInput" placeholder="Speak to the officer…" required></textarea>
        <button class="send" type="submit">Send</button>
      </form>
      <div class="row-actions">
        <button class="btn ghost" type="button" id="copyPrompt">Copy Grok prompt</button>
        <button class="btn ghost" type="button" id="clearChat">Clear thread</button>
      </div>
    </section>

    <section class="view" id="view-council">
      <p class="kicker">Council chamber</p>
      <h2 class="lead">Convene the nine.</h2>
      <p class="blurb">State the matter once. Each officer answers from their chair. Helm closes with the order of the day.</p>
      <div class="council-box">
        <textarea id="councilQ" placeholder="What needs a decision, a plan, or a hard look?"></textarea>
        <button class="btn full" type="button" id="convene">Convene council</button>
      </div>
      <div class="minutes" id="minutes"></div>
    </section>

    <section class="view" id="view-log">
      <p class="kicker">Log book</p>
      <h2 class="lead">The day, written down.</h2>
      <p class="blurb">Stand-up notes, decisions, and work that must move. This is the memory of the company on this deck.</p>
      <div class="chips" id="logChips"></div>
      <div class="card">
        <h3 id="logFormTitle">New entry</h3>
        <label for="logBody">Note</label>
        <textarea class="field" id="logBody" rows="4" placeholder="What happened. What was decided. What is next."></textarea>
        <button class="btn full" type="button" id="saveLog">Commit to log</button>
      </div>
      <div class="card">
        <h3>Open work</h3>
        <label for="taskBody">Task</label>
        <input type="text" id="taskBody" placeholder="One concrete move" />
        <label for="taskOwner">Owner</label>
        <select id="taskOwner"></select>
        <button class="btn full" type="button" id="saveTask">Add task</button>
        <div id="taskList"></div>
      </div>
      <div class="card">
        <h3>Recent pages</h3>
        <div id="logList"></div>
      </div>
    </section>

    <section class="view" id="view-dossier">
      <p class="kicker">Company dossier</p>
      <h2 class="lead">What the officers know.</h2>
      <p class="blurb">Fill this once and keep it current. Every counsel on this deck reads the dossier before it speaks.</p>
      <div class="card">
        <label for="coName">House name</label>
        <input type="text" id="coName" />
        <label for="coStage">Stage</label>
        <input type="text" id="coStage" placeholder="Formation / build / first revenue / scale" />
        <label for="coMission">Mission</label>
        <textarea class="field" id="coMission" rows="3" placeholder="What this house exists to do."></textarea>
        <label for="coOffers">Offers / ventures</label>
        <textarea class="field" id="coOffers" rows="3" placeholder="Social Club, HPC, others…"></textarea>
        <label for="coMarket">Market &amp; geography</label>
        <input type="text" id="coMarket" placeholder="e.g. Johannesburg · ZA · B2B + B2C" />
        <label for="coCash">Cash &amp; constraints</label>
        <textarea class="field" id="coCash" rows="2" placeholder="Runway, burn, what is scarce."></textarea>
        <label for="coNow">This season</label>
        <textarea class="field" id="coNow" rows="3" placeholder="The one or two things that matter in the next 90 days."></textarea>
        <label for="coNotes">Private notes</label>
        <textarea class="field" id="coNotes" rows="4"></textarea>
        <button class="btn full" type="button" id="saveDossier">Save dossier</button>
        <p class="hint" id="dossierSaved" hidden>Dossier written.</p>
      </div>
      <div class="card">
        <h3>Export</h3>
        <p class="hint">Download a markdown brief of the house, the log, and open work — ready to paste into Grok.</p>
        <button class="btn full ghost" type="button" id="exportMd">Download house brief</button>
      </div>
    </section>
  </div>

  <nav class="dock" id="dock"></nav>
  <script>
const AGENTS = [
  {
    id: "helm",
    name: "Silas Vane",
    rank: "Helm · Principal",
    role: "Strategy, capital, final call",
    voice: "Spare. Decides. Protects time and capital. Speaks last in council.",
    lens: ["priority", "tradeoff", "focus", "no", "sequence"],
    asks: [
      "What is the one outcome that makes the rest easier?",
      "What are we pretending is a strategy that is only activity?",
      "If we could only do three things this month, which three?"
    ]
  },
  {
    id: "quarter",
    name: "Ira Denham",
    rank: "Quartermaster · Finance",
    role: "Cash, price, unit economics",
    voice: "Numbers first. Will not bless a plan that cannot pay for itself.",
    lens: ["cash", "price", "margin", "runway", "cost"],
    asks: [
      "Where does the cash actually come from, and when?",
      "What is the unit that must be profitable?",
      "What are we spending that does not buy a result?"
    ]
  },
  {
    id: "nav",
    name: "Kade Ndlovu",
    rank: "Navigator · Market",
    role: "Position, competitors, timing",
    voice: "Maps the water. Cares about where the demand already is.",
    lens: ["market", "competitor", "position", "timing", "wedge"],
    asks: [
      "Who already pays for a worse version of this?",
      "Why us, in this city, in this season?",
      "What must be true in the market for this to work?"
    ]
  },
  {
    id: "signal",
    name: "Mara Voss",
    rank: "Signal · Brand",
    role: "Narrative, channels, desire",
    voice: "Editorial. Attention is scarce. Taste is a strategy.",
    lens: ["brand", "story", "channel", "audience", "creative"],
    asks: [
      "What do they feel before they understand?",
      "Which channel do we actually own, not rent?",
      "What would we never say, even to grow?"
    ]
  },
  {
    id: "engine",
    name: "Rook Mthembu",
    rank: "Engine · Product & ops",
    role: "Build, delivery, systems",
    voice: "Constraints over wishes. Shipping beats theatre.",
    lens: ["build", "ops", "system", "scope", "delivery"],
    asks: [
      "What is the smallest version that is still real?",
      "Where does work get stuck?",
      "What will break when ten people show up at once?"
    ]
  },
  {
    id: "harbor",
    name: "Juno Hale",
    rank: "Harbor · Commercial",
    role: "Sales, partners, pipeline",
    voice: "Closes. Counts conversations, not intentions.",
    lens: ["sale", "pipeline", "partner", "offer", "close"],
    asks: [
      "Who is the next ten buyers, by name or by desk?",
      "What is the offer in one sentence they can repeat?",
      "What stops a yes after a good meeting?"
    ]
  },
  {
    id: "charter",
    name: "Isolde Hart",
    rank: "Charter · Structure",
    role: "Entity, paper, exposure",
    voice: "Quiet paper. Prevents expensive surprises.",
    lens: ["legal", "entity", "contract", "risk", "compliance"],
    asks: [
      "Whose name sits on the risk if this goes badly?",
      "What must be on paper before money moves?",
      "Are we structured for the house we say we are?"
    ]
  },
  {
    id: "crew",
    name: "Amina Calder",
    rank: "Crew · People",
    role: "Capacity, hiring, energy",
    voice: "Will not scale a machine that burns its people.",
    lens: ["hire", "capacity", "culture", "energy", "role"],
    asks: [
      "Who is actually doing the work this week?",
      "What role, if filled, unlocks the rest?",
      "What should the principal stop doing?"
    ]
  },
  {
    id: "watch",
    name: "Asher Pike",
    rank: "Watch · Intelligence",
    role: "Threats, gaps, weak signals",
    voice: "Looks where others will not. Names the thing that can sink the ship.",
    lens: ["risk", "intel", "assumption", "blind", "signal"],
    asks: [
      "What are we assuming that has not been tested?",
      "Who benefits if we are slow?",
      "What would a serious rival do this month?"
    ]
  }
];

const KEY = "helm.v1";
const defaultState = () => ({
  dossier: {
    name: "HELM",
    stage: "